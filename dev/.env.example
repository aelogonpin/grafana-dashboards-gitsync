# Copia este fichero a dev/.env y rellénalo. dev/.env está en .gitignore: nunca se sube.
#   cp dev/.env.example dev/.env

# Token de GitHub con acceso al repo (Contents, Pull requests y Webhooks en Read and write).
GITHUB_TOKEN=

# Opcional: puerto de Grafana en esta máquina (por defecto 3001).
# GRAFANA_PORT=3001

# Opcional: contraseña del usuario admin (por defecto admin).
# Cámbiala si Grafana va a ser accesible desde otros dispositivos de la red.
# GRAFANA_ADMIN_PASSWORD=

# Opcional: URL con la que se entra a Grafana desde otros dispositivos
# (IP de la máquina en la red o en la VPN), con barra final.
# GRAFANA_ROOT_URL=http://192.168.1.50:3001/
