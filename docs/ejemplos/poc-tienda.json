{
  "__inputs": [
    { "name": "DS_MIMIR-CLIENTE-A", "label": "Mimir-cliente-a", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" },
    { "name": "DS_LOKI-CLIENTE-A",  "label": "Loki-cliente-a",  "type": "datasource", "pluginId": "loki",       "pluginName": "Loki" }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "13.2.4" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki",       "name": "Loki",       "version": "1.0.0" }
  ],
  "id": null,
  "uid": "aB3dE5fG7h",
  "title": "POC - Tienda en vivo",
  "tags": ["poc"],
  "schemaVersion": 41,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Pedidos (15 min)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI-CLIENTE-A}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI-CLIENTE-A}" },
                     "expr": "sum(count_over_time({app=\"tienda\"} |= \"pedido creado\" [15m]))" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "Errores (15 min)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI-CLIENTE-A}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI-CLIENTE-A}" },
                     "expr": "sum(count_over_time({app=\"tienda\", level=\"error\"}[15m]))" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 50 } ] } }, "overrides": [] }
    },
    {
      "id": 3, "type": "gauge", "title": "CPU del nodo (%)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR-CLIENTE-A}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_MIMIR-CLIENTE-A}" },
                     "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 4, "type": "gauge", "title": "Memoria del nodo (%)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR-CLIENTE-A}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_MIMIR-CLIENTE-A}" },
                     "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 5, "type": "timeseries", "title": "Logs por nivel (por minuto)",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI-CLIENTE-A}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI-CLIENTE-A}" },
                     "expr": "sum by (level) (count_over_time({app=\"tienda\"}[1m]))", "legendFormat": "{{level}}" } ]
    },
    {
      "id": 6, "type": "logs", "title": "Últimos errores y avisos",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI-CLIENTE-A}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI-CLIENTE-A}" },
                     "expr": "{app=\"tienda\", level=~\"error|warn\"}" } ]
    }
  ]
}
