{
  "uid": "a-ventas",
  "title": "Cliente A - Ventas",
  "tags": [
    "demo"
  ],
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_mimir",
        "label": "Mimir",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Mimir/",
        "hide": 2
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "regex": "/^Loki/",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Pedidos por minuto",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({app=\"tienda\"} |= \"pedido creado\" [1m]))",
          "legendFormat": "pedidos"
        }
      ],
      "id": 1
    },
    {
      "type": "logs",
      "title": "Pedidos",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{app=\"tienda\"} |= \"pedido creado\""
        }
      ],
      "id": 2
    }
  ]
}
