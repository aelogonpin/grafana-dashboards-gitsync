{
  "uid": "a-negocio",
  "title": "Cliente A - Negocio online",
  "description": "KPIs de la tienda online de cliente-a a partir de sus logs y métricas",
  "tags": [
    "negocio",
    "cliente-a"
  ],
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_mimir",
        "label": "Mimir",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Mimir/",
        "hide": 2
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "regex": "/^Loki/",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Facturación (última hora)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(sum_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=\"pedido creado\" | unwrap importe [1h]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Pedidos (última hora)",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=\"pedido creado\" [1h]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Ticket medio",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(sum_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=\"pedido creado\" | unwrap importe [1h])) / sum(count_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=\"pedido creado\" [1h]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        }
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Pagos rechazados",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "100 * sum(count_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=\"pago rechazado\" [1h])) / sum(count_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=~\"pedido creado|pago rechazado\" [1h]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        }
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Carritos abandonados (última hora)",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=\"carrito abandonado\" [1h]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Facturación por canal (cada 5 min)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (canal) (sum_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=\"pedido creado\" | canal!=\"\" | unwrap importe [5m]))",
          "legendFormat": "{{canal}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0
        }
      },
      "id": 6
    },
    {
      "type": "piechart",
      "title": "Pedidos por método de pago (última hora)",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (metodo) (count_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=\"pedido creado\" | metodo!=\"\" [1h]))",
          "legendFormat": "{{metodo}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "id": 7
    },
    {
      "type": "bargauge",
      "title": "Facturación por región (última hora)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (region) (sum_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=\"pedido creado\" | region!=\"\" | unwrap importe [1h]))",
          "legendFormat": "{{region}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Latencia del checkout p95 (ms)",
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "quantile_over_time(0.95, {app=\"tienda\"} | logfmt | __error__=\"\" | endpoint=\"/checkout\" | canal!=\"\" | unwrap duration_ms [5m]) by (canal)",
          "legendFormat": "{{canal}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "id": 9
    },
    {
      "type": "bargauge",
      "title": "Motivos de rechazo (última hora)",
      "gridPos": {
        "x": 18,
        "y": 13,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (motivo) (count_over_time({app=\"tienda\"} | logfmt | __error__=\"\" | msg=\"pago rechazado\" [1h]))",
          "legendFormat": "{{motivo}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "lcd"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      },
      "id": 10
    },
    {
      "type": "logs",
      "title": "Alertas de stock bajo",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{app=\"tienda\", level=\"warn\"} |= \"stock bajo\""
        }
      ],
      "id": 11
    },
    {
      "type": "logs",
      "title": "Últimos pagos rechazados",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{app=\"tienda\", level=\"error\"} |= \"pago rechazado\""
        }
      ],
      "id": 12
    },
    {
      "type": "gauge",
      "title": "CPU de la plataforma (%)",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Peticiones a la plataforma (por segundo)",
      "gridPos": {
        "x": 6,
        "y": 30,
        "w": 18,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum(rate(prometheus_http_requests_total[1m]))",
          "legendFormat": "peticiones/s"
        }
      ],
      "id": 14
    }
  ]
}
