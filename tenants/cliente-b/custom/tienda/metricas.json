{
  "uid": "cliente-b-tienda-metricas",
  "title": "Cliente B - Tienda: métricas",
  "description": "Negocio, API (RED) y agentes de la tienda, desde Mimir",
  "tags": [
    "tienda",
    "cliente-b",
    "metricas"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 41,
  "links": [
    {
      "title": "Tienda",
      "type": "dashboards",
      "tags": [
        "tienda"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds_mimir",
        "label": "Mimir",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Mimir/",
        "hide": 2
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "regex": "/^Loki/",
        "hide": 2
      },
      {
        "name": "ds_tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "regex": "/^Tempo/",
        "hide": 2
      },
      {
        "name": "cluster",
        "label": "Origen",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_mimir}"
        },
        "query": {
          "query": "label_values(up{job=\"tienda\"}, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(up{job=\"tienda\"}, cluster)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Negocio",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Pedidos (última hora)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum(increase(tienda_pedidos_total{cluster=\"$cluster\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Facturación (última hora)",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum(increase(tienda_importe_euros_total{cluster=\"$cluster\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Pagos rechazados (5 min)",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "100 * sum(rate(tienda_pagos_rechazados_total{cluster=\"$cluster\"}[5m])) / (sum(rate(tienda_pagos_rechazados_total{cluster=\"$cluster\"}[5m])) + sum(rate(tienda_pedidos_total{cluster=\"$cluster\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 4,
      "description": "Rechazados / (pedidos + rechazados)"
    },
    {
      "type": "stat",
      "title": "Latencia p95 de /checkout (5 min)",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{cluster=\"$cluster\", job=\"tienda\", handler=\"/checkout\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Pedidos por minuto, por canal",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum by (canal) (rate(tienda_pedidos_total{cluster=\"$cluster\"}[5m])) * 60",
          "legendFormat": "{{canal}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Facturación por minuto, por canal",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum by (canal) (rate(tienda_importe_euros_total{cluster=\"$cluster\"}[5m])) * 60",
          "legendFormat": "{{canal}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 7
    },
    {
      "type": "piechart",
      "title": "Pedidos por método de pago (última hora)",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum by (metodo) (increase(tienda_pedidos_total{cluster=\"$cluster\"}[1h]))",
          "legendFormat": "{{metodo}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "id": 8
    },
    {
      "type": "bargauge",
      "title": "Pagos rechazados por motivo (última hora)",
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sort_desc(sum by (motivo) (increase(tienda_pagos_rechazados_total{cluster=\"$cluster\"}[1h])))",
          "legendFormat": "{{motivo}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 9
    },
    {
      "type": "stat",
      "title": "Agentes del cliente",
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "up{cluster=\"$cluster\", job=~\"tienda|prometheus|fluent-bit|alloy\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CAÍDO",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "id": 10,
      "description": "up de la app y de sus agentes: Prometheus (métricas), Fluent Bit (logs) y Alloy (trazas)"
    },
    {
      "type": "row",
      "title": "API (tasa, errores, duración)",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": [],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Peticiones por segundo, por endpoint y estado",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum by (handler, status) (rate(http_requests_total{cluster=\"$cluster\", job=\"tienda\"}[1m]))",
          "legendFormat": "{{handler}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* (4|5)\\d\\d"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Latencia por endpoint (p50 / p95 / p99)",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, handler) (rate(http_request_duration_seconds_bucket{cluster=\"$cluster\", job=\"tienda\"}[5m])))",
          "legendFormat": "{{handler}} p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{cluster=\"$cluster\", job=\"tienda\"}[5m])))",
          "legendFormat": "{{handler}} p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(http_request_duration_seconds_bucket{cluster=\"$cluster\", job=\"tienda\"}[5m])))",
          "legendFormat": "{{handler}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 13
    },
    {
      "type": "row",
      "title": "Plataforma del cliente",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": [],
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Memoria residente de la app",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "process_resident_memory_bytes{cluster=\"$cluster\", job=\"tienda\"}",
          "legendFormat": "tienda"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Muestras enviadas a Mimir (por segundo)",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum(rate(prometheus_remote_storage_samples_total{cluster=\"$cluster\", job=\"prometheus\"}[5m]))",
          "legendFormat": "enviadas"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum(rate(prometheus_remote_storage_samples_failed_total{cluster=\"$cluster\", job=\"prometheus\"}[5m]))",
          "legendFormat": "fallidas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fallidas"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "id": 16
    }
  ]
}
