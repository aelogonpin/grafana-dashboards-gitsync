{
  "uid": "b-red",
  "title": "Cliente B - Red",
  "tags": [
    "demo"
  ],
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_mimir",
        "label": "Mimir",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Mimir/",
        "hide": 2
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "regex": "/^Loki/",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Tráfico recibido (bytes/s)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum by (device) (rate(node_network_receive_bytes_total[1m]))",
          "legendFormat": "{{device}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Tráfico enviado (bytes/s)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_mimir}"
          },
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total[1m]))",
          "legendFormat": "{{device}}"
        }
      ],
      "id": 2
    }
  ]
}
